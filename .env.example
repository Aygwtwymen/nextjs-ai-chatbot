# Required: create an API key with your OpenAI-compatible provider.
# Keep the real key in .env.local or Vercel project environment variables, never in source control.
OPENAI_API_KEY=your_api_key_here

# Optional. Defaults to OpenAI's API; use an OpenAI-compatible provider URL if desired.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
